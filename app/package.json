{
  "name": "pdf-toolkit",
  "version": "1.0.0",
  "description": "A powerful toolkit for PDF operations",
  "main": "./out/main/index.js",
  "author": "Vibe Code",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:store": "npm run build && electron-builder --win appx",
    "build:portable": "npm run build && electron-builder --win portable",
    "build:setup": "npm run build && electron-builder --win nsis",
    "generate:appx-assets": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-appx-assets.ps1",
    "sign:local-appx": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-local-appx.ps1",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/jszip": "^3.4.0",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.14",
    "officeparser": "^7.5.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "react-easy-crop": "^6.2.3",
    "sonner": "^2.0.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "postcss": "^8.5.22",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
